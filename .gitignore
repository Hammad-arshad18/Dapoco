# Dependencies (root and tools/model-pipeline)
node_modules/

# Build output & caches
dist/
dist-ssr/
*.local
.vite/
.cache/
.eslintcache
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment / secrets
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editors / IDEs
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-workspace

# Claude Code — keep shared launch config, ignore personal settings
.claude/*
!.claude/launch.json
!.claude/settings.json

# Offline model pipeline working files (raw downloads, intermediates, reports)
tools/model-pipeline/raw/
tools/model-pipeline/work/
tools/model-pipeline/out/
tools/model-pipeline/*.jsonl
tools/model-pipeline/*.png
