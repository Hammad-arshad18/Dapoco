# Apache / LiteSpeed (Hostinger, cPanel …). Netlify / Cloudflare Pages use _redirects instead.

# Single-page app: any path that isn't a real file goes to index.html, so /studio,
# /collections/home-furniture etc. work on refresh and when shared as links.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/octet-stream
</IfModule>

<IfModule mod_headers.c>
  # index.html must always be re-checked so visitors get new builds straight away
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # build files have content hashes in their names → safe to cache for a year
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # models, photos, thumbnails, HDRI keep their names between builds → cache a week
  <If "%{REQUEST_URI} =~ m#^/(models|images|thumbs|hdri|brand)/#">
    Header set Cache-Control "public, max-age=604800"
  </If>
</IfModule>
